# Auth.js — en prod: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret
AUTH_TRUST_HOST=true

# Railway: /data (ruta del volumen). Local: déjalo vacío.
DATA_DIR=

# Primer admin si la DB está vacía. En prod usa credenciales reales.
ADMIN_EMAIL=admin@softsolutions.mx
ADMIN_PASSWORD=admin123

# true solo en local/demo. En prod: false
ENABLE_DEMO_SEED=false

# Stripe — test en local (sk_test_…), live solo en prod (sk_live_…)
STRIPE_SECRET_KEY=
# Local: whsec_ de `stripe listen`. Prod: whsec_ del webhook en el dashboard.
STRIPE_WEBHOOK_SECRET=

# Resend — invitaciones. Sin esto, el admin copia el link a mano.
RESEND_API_KEY=
EMAIL_FROM=SoftSolutions <onboarding@resend.dev>
